{
  "name": "limbo-encoder",
  "version": "1.0.0",
  "private": true,
  "description": "Shrink any video to fit any upload limit — 100% local in your browser, nothing gets uploaded.",
  "license": "MIT",
  "author": "Elad Karni",
  "repository": {
    "type": "git",
    "url": "https://github.com/EladKarni/limbo-encoder.git"
  },
  "dependencies": {
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "mp4-muxer": "^5.2.2",
    "mp4box": "0.5.4",
    "prop-types": "^15.7.2",
    "react": "17.0.0",
    "react-dom": "17.0.0",
    "react-dropzone": "^11.2.4",
    "react-scripts": "4.0.0",
    "sass": "^1.49.9"
  },
  "scripts": {
    "copy:ffmpeg": "node scripts/copy-ffmpeg-assets.js",
    "prestart": "yarn copy:ffmpeg",
    "prebuild": "yarn copy:ffmpeg",
    "start": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "NODE_OPTIONS=--openssl-legacy-provider react-scripts test",
    "lint": "eslint src scripts --ext .js",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "airbnb"
    ],
    "rules": {
      "jsdoc/require-jsdoc": 0,
      "react/jsx-filename-extension": 0,
      "react/jsx-props-no-spreading": 0,
      "react/forbid-prop-types": 0
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "eslint-config-airbnb": "18.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.21.5",
    "eslint-plugin-react-hooks": "^4.2.0"
  }
}
